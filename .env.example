# VIGIL AI – Environment Configuration
# Copy this file to .env and update values

# Application
APP_NAME=VIGIL AI
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Model
MODEL_PATH=../models/weights/vigil_model.pth
MODEL_ARCH=cnn_lstm          # Options: cnn_lstm | 3dcnn
CONFIDENCE_THRESHOLD=0.5
DEMO_MODE=true               # Set to false when real model weights exist

# Video Processing
MAX_FRAMES=16
FRAME_SIZE=112
MAX_UPLOAD_SIZE_MB=100

# Database
DATABASE_URL=sqlite:///./vigil.db

# Datasets
RWF2000_PATH=../datasets/rwf2000
HOCKEY_PATH=../datasets/hockey
ANNOTATIONS_PATH=../datasets/annotations/category_annotations.csv

# Training
BATCH_SIZE=8
EPOCHS=30
LEARNING_RATE=0.001
